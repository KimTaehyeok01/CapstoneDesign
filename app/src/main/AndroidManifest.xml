<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 위치 권한 설정 -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CapstoneDesign"
        tools:targetApi="31">

        <!-- In-App Messaging 자동 데이터 수집 활성화 -->
        <meta-data
            android:name="firebase_inapp_messaging_automatic_data_collection_enabled"
            android:value="true" />

        <!-- Google Maps API 키 등록 -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDueINzzegFrO2LUfBIoj9C94mvIwJH_VI" />

        <!-- 메인 페이지 -->
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <!-- 로그인 액티비티 -->
        <activity android:name=".login_signup.LoginActivity" />

        <!-- 회원가입 액티비티 -->
        <activity android:name=".login_signup.SignUpActivity" />

        <!-- 비밀번호 찾기 액티비티 -->
        <activity android:name=".login_signup.FindPwActivity" />

        <!-- 레포츠 선택 액티비티 -->
        <activity android:name=".login_signup.SportsSelectActivity" />

        <!-- 성별 선택 액티비티 -->
        <activity android:name=".login_signup.GenderSelectActivity" />

        <!-- 신장 입력 액티비티 -->
        <activity android:name=".login_signup.InputHeightActivity" />

        <!-- 계절 선택 액티비티 -->
        <activity android:name=".login_signup.SeasonSelectActivity" />

        <!-- 검색 창 액티비티 -->
        <activity android:name=".SearchActivity" />

        <!-- 찜 화면 액티비티 -->
        <activity android:name=".FavoriteListActivity" />

        <!-- 설정 액티비티 -->
        <activity android:name=".settings_information.SettingsActivity" />

        <!-- 나이 입력 액티비티 -->
        <activity
            android:name=".login_signup.AgeInputActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- 지도 화면 액티비티 -->
        <activity android:name=".MapActivity" />

        <!-- 상세페이지 화면 액티비티 -->
        <activity android:name=".PlaceDetailActivity" />

        <!-- 내정보(설정) 액티비티 -->
        <activity android:name=".settings_information.InformationActivity" />

        <!-- 계정정보(설정) 액티비티 -->
        <activity android:name=".settings_information.AccountInfoActivity" />

        <!-- 계정정보(탈퇴하기) 액티비티 -->
        <activity android:name=".settings_information.WithdrawActivity" />

        <!-- 계정정보(비밀번호 변경) 액티비티 -->
        <activity android:name=".settings_information.PasswordChangeActivity" />

        <!-- 계정정보(관심사 변경) 액티비티 -->
        <activity android:name=".settings_information.InterestChangeActivity" />

        <!-- 계정정보(푸시알림설정) 액티비티 -->
        <activity android:name=".settings_information.PushSettingActivity" />

        <!-- 오늘의 추천 화면 액티비티 -->
        <activity android:name=".TodayRecommendActivity" />

        <!-- 주변 활동 추천 화면 액티비티 -->
        <activity android:name=".NearbyRecommendActivity" />

        <service
            android:name=".settings_information.MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- 앱 시작 시 실행될 온보딩 화면 -->
        <activity
            android:name=".login_signup.OnboardingActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>