<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FEFBF3"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/topAppBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search_ic_back_arrow"
            android:background="@android:color/transparent"/>

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="스탬프"
            android:textSize="16sp"
            android:gravity="center"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvWeather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 날씨 ☀️"
            android:textSize="12sp"/>
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topAppBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@android:color/white">

                    <TextView
                        android:id="@+id/tv_current_tier_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 티어: 실버"
                        android:textColor="@android:color/black"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="12dp"/>

                    <ImageView
                        android:id="@+id/tier_badge"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:src="@drawable/silver_badge"
                        android:contentDescription="티어 뱃지"
                        android:layout_marginBottom="16dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="종목" android:textColor="@android:color/black" android:layout_weight="1" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="횟수" android:textColor="@android:color/black" android:layout_weight="1" android:gravity="center" android:textStyle="bold"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="티어" android:textColor="@android:color/black" android:layout_weight="1" android:gravity="end" android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="육상" android:textColor="@android:color/darker_gray" android:layout_weight="1"/>
                        <TextView android:id="@+id/tv_athletics_count" android:layout_width="0dp" android:layout_height="wrap_content" android:text="3" android:textColor="@android:color/darker_gray" android:layout_weight="1" android:gravity="center"/>
                        <TextView android:id="@+id/tv_athletics_tier" android:layout_width="0dp" android:layout_height="wrap_content" android:text="silver" android:textColor="@android:color/darker_gray" android:layout_weight="1" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="수상" android:textColor="@android:color/darker_gray" android:layout_weight="1"/>
                        <TextView android:id="@+id/tv_water_sports_count" android:layout_width="0dp" android:layout_height="wrap_content" android:text="4" android:textColor="@android:color/darker_gray" android:layout_weight="1" android:gravity="center"/>
                        <TextView android:id="@+id/tv_water_sports_tier" android:layout_width="0dp" android:layout_height="wrap_content" android:text="bronze" android:textColor="@android:color/darker_gray" android:layout_weight="1" android:gravity="end"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:text="항공" android:textColor="@android:color/darker_gray" android:layout_weight="1"/>
                        <TextView android:id="@+id/tv_air_sports_count" android:layout_width="0dp" android:layout_height="wrap_content" android:text="5" android:textColor="@android:color/darker_gray" android:layout_weight="1" android:gravity="center"/>
                        <TextView android:id="@+id/tv_air_sports_tier" android:layout_width="0dp" android:layout_height="wrap_content" android:text="gold" android:textColor="@android:color/darker_gray" android:layout_weight="1" android:gravity="end"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:layout_marginBottom="16dp"
                android:layout_marginHorizontal="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="@android:color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/btn_category_athletics"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="8dp"
                                android:text="육상"
                                android:textSize="16sp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/btn_category_water"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="8dp"
                                android:text="수상"
                                android:textSize="16sp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"/>

                            <TextView
                                android:id="@+id/btn_category_air"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="8dp"
                                android:text="항공"
                                android:textSize="16sp"
                                android:background="?attr/selectableItemBackground"
                                android:clickable="true"
                                android:focusable="true"/>

                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_next_tier_progress_header"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="다음 티어까지 3"
                            android:textColor="@android:color/holo_blue_dark"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_dynamic_tier_tag"
                        android:layout_width="wrap_content"  android:layout_height="wrap_content" android:text="Silver"
                        android:textColor="@android:color/white"
                        android:background="@drawable/rounded_silver_background"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="4dp"
                        android:textSize="14sp"
                        android:layout_marginBottom="16dp"/>
                    <LinearLayout
                        android:id="@+id/btn_tier_analysis"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_list"
                            android:contentDescription="리스트 아이콘"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="다음 티어달성 분석표"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btn_visited_list" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp"
                        android:background="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:padding="8dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_maplist"
                            android:contentDescription="보기 아이콘"
                            android:layout_marginEnd="8dp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="방문한 리스트 보기"
                            android:textColor="@android:color/black"
                            android:textSize="15sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_next_tier_progress_footer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="다음 티어까지 7개 남았어요"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="14sp"
                        android:layout_gravity="end"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <Button
                android:id="@+id/btn_nearby_stamps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="가까운 스탬프 장소"
                android:layout_marginBottom="12dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>