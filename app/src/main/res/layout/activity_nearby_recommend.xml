<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_recommend_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7">

    <!-- 1. 상단 바 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackRecommend"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search_ic_back_arrow"
            android:background="@null"
            android:contentDescription="뒤로 가기 버튼"
            android:onClick="onBackClicked"/>

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="어플 이름"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvWeatherRecommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 날씨 ☀️"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- 2. 검색 바 -->
    <EditText
        android:id="@+id/editSearchRecommend"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/search_edittext_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:hint="활동하고 싶은 레저를 검색해보세요"
        android:padding="8dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 3. 본문 스크롤 -->
    <ScrollView
        android:id="@+id/scrollViewRecommend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/editSearchRecommend"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/content_layout"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- 오늘의 추천 헤더 -->
            <TextView
                android:id="@+id/tvRecommendHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="주변 활동 추천!"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- 카드 인플레이트용 컨테이너 -->
            <LinearLayout
                android:id="@+id/item_container"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
