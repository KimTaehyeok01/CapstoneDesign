<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_interest_change"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- 뒤로가기 -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_setting_left_arrow"
        android:onClick="onBackClicked"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 타이틀 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="관심사 변경"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 상단 구분선 -->
    <ImageView
        android:id="@+id/lineTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        android:src="@drawable/setting_line"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- “계절” 레이블 -->
    <TextView
        android:id="@+id/tvSeasonLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="계절"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/lineTop"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 계절 버튼들 -->
    <LinearLayout
        android:id="@+id/llSeasonButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSeasonLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSeasonSpring"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_interest_change_season"
            android:backgroundTint="#D88480"
            android:text="봄"
            android:textColor="@android:color/white"
            android:onClick="onSeasonSpringClicked"/>

        <Button
            android:id="@+id/btnSeasonSummer"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_interest_change_season"
            android:backgroundTint="#D88480"
            android:text="여름"
            android:textColor="@android:color/white"
            android:onClick="onSeasonSummerClicked"/>

        <Button
            android:id="@+id/btnSeasonFall"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_interest_change_season"
            android:backgroundTint="#D88480"
            android:text="가을"
            android:textColor="@android:color/white"
            android:onClick="onSeasonFallClicked"/>

        <Button
            android:id="@+id/btnSeasonWinter"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/ic_interest_change_season"
            android:backgroundTint="#D88480"
            android:text="겨울"
            android:textColor="@android:color/white"
            android:onClick="onSeasonWinterClicked"/>
    </LinearLayout>

    <!-- 계절 안내문 -->

    <!-- 중간 구분선 -->

    <!-- “레저스포츠” 레이블 -->

    <TextView
        android:id="@+id/tvSeasonInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="220dp"
        android:layout_marginTop="52dp"
        android:text="선호하는 계절을 선택해주세요"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llSeasonButtons" />

    <ImageView
        android:id="@+id/lineMid"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="28dp"
        android:src="@drawable/ic_interest_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSeasonInstruction" />

    <TextView
        android:id="@+id/tvSportsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="24dp"
        android:text="레저스포츠"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/lineMid"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 스포츠 버튼들 -->
    <LinearLayout
        android:id="@+id/llSportsButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tvSportsLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnSportsLand"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_interest_change_sports"
            android:backgroundTint="#D88480"
            android:text="육상 스포츠"
            android:textColor="@android:color/white"
            android:onClick="onSportsLandClicked"/>

        <Button
            android:id="@+id/btnSportsSea"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@drawable/ic_interest_change_sports"
            android:backgroundTint="#D88480"
            android:text="해상 스포츠"
            android:textColor="@android:color/white"
            android:onClick="onSportsSeaClicked"/>

        <Button
            android:id="@+id/btnSportsAir"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/ic_interest_change_sports"
            android:backgroundTint="#D88480"
            android:text="항공 스포츠"
            android:textColor="@android:color/white"
            android:onClick="onSportsAirClicked"/>
    </LinearLayout>

    <!-- 스포츠 안내문 -->

    <!-- 확인 버튼 (건들지 않음) -->

    <TextView
        android:id="@+id/tvSportsInstruction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="204dp"
        android:layout_marginTop="48dp"
        android:text="선호하는 스포츠를 선택해주세요"
        android:textColor="@android:color/darker_gray"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/llSportsButtons" />

    <FrameLayout
        android:id="@+id/btnConfirmContainer"
        android:layout_width="283dp"
        android:layout_height="62dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSubmitPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pw_modify"
            android:scaleType="fitXY"/>

        <TextView
            android:id="@+id/btnSubmitText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="확인"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
