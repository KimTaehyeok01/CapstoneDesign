<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="16dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/img_place_container"
        android:layout_width="120dp"
        android:layout_height="120dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/img_place"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="장소 이미지"
            android:scaleType="centerCrop"
            tools:src="@drawable/ic_climb" />

    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tv_place_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="장소명"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/img_place_container"
        app:layout_constraintEnd_toStartOf="@id/img_favorite"
        app:layout_constraintTop_toTopOf="@id/img_place_container" />

    <TextView
        android:id="@+id/tv_place_address"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="주소"
        android:textSize="14sp"
        android:textColor="@android:color/darker_gray"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="@id/tv_place_name"
        app:layout_constraintEnd_toEndOf="@id/tv_place_name"
        app:layout_constraintTop_toBottomOf="@id/tv_place_name" />

    <ImageView
        android:id="@+id/icon_location"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@drawable/baseline_edit_location_24"
        app:tint="#8A8A8A"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="@id/tv_place_address"
        app:layout_constraintTop_toBottomOf="@id/tv_place_address"/>

    <TextView
        android:id="@+id/tv_place_region"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="지역명"
        android:textSize="13sp"
        android:textColor="@android:color/black"
        android:layout_marginStart="4dp"
        app:layout_constraintStart_toEndOf="@id/icon_location"
        app:layout_constraintTop_toTopOf="@id/icon_location"
        app:layout_constraintBottom_toBottomOf="@id/icon_location"/>

    <ImageView
        android:id="@+id/img_favorite"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@drawable/baseline_favorite_border_24"
        app:tint="@android:color/black"
        android:contentDescription="찜 버튼"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/img_place_container" />

    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F0F0F0"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_place_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>