<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 메인 콘텐츠 (기존 activity_main.xml 전체) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFDF7">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/iv_menu"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_menu"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"
                        android:onClick="onMenuClick" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="레저스포츠"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/tv_weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="현재 날씨 ☀️"
                        android:textSize="12sp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground"/>
                </LinearLayout>

                <EditText
                    android:id="@+id/main_search_bar"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/search_edittext_bg"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:hint="활동하고 싶은 레저를 검색해보세요"
                    android:padding="8dp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="4"
                    android:alignmentMode="alignMargins"
                    android:padding="8dp"
                    android:layout_marginBottom="16dp">

                    <!-- 카테고리 아이콘들 (클라이밍, 카누, 서핑, ...) -->
                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_climbing" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="클라이밍"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_canoe" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="카누"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_surfing" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="서핑"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_archery" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="양궁"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_ski" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="스키"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_iceskating" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="아이스 스케이트"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_hangglider" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="행글라이딩"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center"
                        android:padding="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">
                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_paragliding" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="패러글라이딩"
                            android:textSize="12sp"
                            android:gravity="center"
                            android:textColor="#000000" />
                    </LinearLayout>

                </GridLayout>

                <TextView
                    android:id="@+id/tv_today_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오늘의 추천!"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/layout_today_item1"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/img_today_item1"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_climb"
                            android:background="@drawable/rounded_bg"
                            android:clipToOutline="true" />
                        <TextView
                            android:id="@+id/tv_today_item1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="부평클라이밍센터"
                            android:textSize="14sp"
                            android:paddingTop="4dp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_today_item2"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/img_today_item2"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_luzi"
                            android:background="@drawable/rounded_bg"
                            android:clipToOutline="true" />
                        <TextView
                            android:id="@+id/tv_today_item2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="강화루지"
                            android:textSize="14sp"
                            android:paddingTop="4dp"
                            android:textColor="#000000"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_nearby_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="주변 활동 추천!"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:foreground="?attr/selectableItemBackground" />

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/layout_nearby_item1"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/img_nearby_item1"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_climb"
                            android:background="@drawable/rounded_bg"
                            android:clipToOutline="true" />
                        <TextView
                            android:id="@+id/tv_nearby_item1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="부평클라이밍센터"
                            android:textSize="14sp"
                            android:paddingTop="4dp"
                            android:textColor="#000000"
                            android:gravity="center"
                            android:layout_gravity="center_horizontal" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layout_nearby_item2"
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:gravity="center_horizontal"
                        android:clickable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <ImageView
                            android:id="@+id/img_nearby_item2"
                            android:layout_width="match_parent"
                            android:layout_height="120dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_luzi"
                            android:background="@drawable/rounded_bg"
                            android:clipToOutline="true" />
                        <TextView
                            android:id="@+id/tv_nearby_item2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="강화루지"
                            android:textSize="14sp"
                            android:paddingTop="4dp"
                            android:textColor="#000000"
                            android:gravity="center" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#FFFDF7"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/nav_search"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:src="@drawable/ic_main_search"
                android:contentDescription="검색" />

            <ImageButton
                android:id="@+id/nav_marker"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:src="@drawable/ic_main_marker"
                android:contentDescription="마커" />

            <ImageButton
                android:id="@+id/nav_home"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:src="@drawable/ic_main_home"
                android:contentDescription="홈" />

            <ImageButton
                android:id="@+id/nav_heart"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:src="@drawable/ic_main_heart"
                android:contentDescription="즐겨찾기" />

            <ImageButton
                android:id="@+id/nav_setting"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:background="@null"
                android:src="@drawable/ic_main_setting"
                android:contentDescription="설정" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 왼쪽에서 슬라이드될 프로필 패널 -->
    <LinearLayout
        android:id="@+id/nav_profile"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@drawable/main_profile"
        android:padding="16dp">

        <!-- 닫기 버튼 -->
        <ImageButton
            android:id="@+id/btn_close_drawer"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_setting_left_arrow"
            android:background="@android:color/transparent"
            android:contentDescription="닫기" />

        <!-- 프로필 헤더 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="24dp"
            android:paddingBottom="16dp">

            <ImageView
                android:id="@+id/img_profile_icon"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_human"
                android:contentDescription="프로필 아이콘" />

            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="이름하세요 님"
                android:textSize="16sp"
                android:textColor="#000000" />
        </LinearLayout>

        <!-- 이메일 -->
        <TextView
            android:id="@+id/tv_profile_email_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이메일:"
            android:textSize="14sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_profile_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="happy@gmail.com"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <!-- 나이 -->
        <TextView
            android:id="@+id/tv_profile_age_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="나이:"
            android:textSize="14sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_profile_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginBottom="12dp" />

        <!-- 관심 종목 -->
        <TextView
            android:id="@+id/tv_profile_interest_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="관심 종목"
            android:textSize="14sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_profile_interest"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="육상 스포츠"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp" />

        <!-- 선호하는 계절 -->
        <TextView
            android:id="@+id/tv_profile_season_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="선호하는 계절"
            android:textSize="14sp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/tv_profile_season"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="겨울"
            android:textSize="14sp"
            android:textColor="#000000"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>