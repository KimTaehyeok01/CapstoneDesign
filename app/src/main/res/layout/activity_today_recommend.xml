<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_recommend_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7">

    <!-- 1. 상단 바 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackRecommend"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search_ic_back_arrow"
            android:background="@null"
            android:contentDescription="뒤로 가기 버튼"/>

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="어플 이름"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvWeatherRecommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 날씨 ☀️"
            android:textSize="12sp"/>

    </LinearLayout>

    <!-- 2. 검색 바 -->
    <EditText
        android:id="@+id/editSearchRecommend"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/search_edittext_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:hint="활동하고 싶은 레저를 검색해보세요"
        android:padding="8dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 3. 콘텐츠 스크롤 영역 -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/editSearchRecommend"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- 추천 헤더 (텍스트 + 새로고침 버튼) -->
            <LinearLayout
                android:id="@+id/header_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:id="@+id/tvRecommendHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="오늘의 추천!"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <ImageButton
                    android:id="@+id/btnRefreshRecommend"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_refresh"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="새로 고침" />

            </LinearLayout>

            <!-- 카드 인플레이트용 컨테이너 -->
            <LinearLayout
                android:id="@+id/item_container"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <!-- 추천 받기 버튼 -->
            <Button
                android:id="@+id/recommendButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="추천받기"
                android:layout_marginTop="16dp"/>

            <!-- 결과 출력 TextView -->
            <TextView
                android:id="@+id/resultTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="추천 결과가 여기에 표시됩니다."
                android:textSize="14sp"
                android:textColor="#000000"
                android:layout_marginTop="12dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
