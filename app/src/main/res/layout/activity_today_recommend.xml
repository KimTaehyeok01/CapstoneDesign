<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/today_recommend_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFDF7">

    <!-- 1. 상단 바 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnBackRecommend"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/search_ic_back_arrow"
            android:background="@null"
            android:contentDescription="뒤로 가기 버튼"
            android:onClick="onBackClicked"/>

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="어플 이름"
            android:textSize="16sp"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvWeatherRecommend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="현재 날씨 ☀️"
            android:textSize="12sp"/>
    </LinearLayout>

    <!-- 2. 검색 바 -->
    <EditText
        android:id="@+id/editSearchRecommend"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/search_edittext_bg"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:hint="활동하고 싶은 레저를 검색해보세요"
        android:padding="8dp"
        android:imeOptions="actionSearch"
        android:inputType="text"
        app:layout_constraintTop_toBottomOf="@id/top_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 3. 본문 스크롤 -->
    <ScrollView
        android:id="@+id/scrollViewRecommend"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/editSearchRecommend"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- 오늘의 추천 헤더 -->
            <TextView
                android:id="@+id/tvRecommendHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="오늘의 추천!"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- 1번째 추천 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRec1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:onClick="onRec1Clicked">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgRec1"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_climb"
                        android:contentDescription="첫 번째 추천 이미지"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvRecTitle1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="역삼 클라이밍랩"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvRecAddress1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="서울 강남구 테헤란로30길 49"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/baseline_edit_location_24"
                                android:contentDescription="위치 아이콘"/>

                            <TextView
                                android:id="@+id/tvRecRegion1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="서울 강남"
                                android:textSize="13sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/baseline_attach_money_24"
                                android:contentDescription="가격 아이콘"/>

                            <TextView
                                android:id="@+id/tvRecPrice1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="무료이용 가능"
                                android:textSize="13sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnFav1"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_favorite_border_24"
                        android:contentDescription="첫 번째 찜 버튼"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2번째 추천 카드 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardRec2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:clickable="true"
                android:foreground="?attr/selectableItemBackground"
                android:onClick="onRec2Clicked">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:id="@+id/imgRec2"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_climb2"
                        android:contentDescription="두 번째 추천 이미지"/>

                    <LinearLayout
                        android:orientation="vertical"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvRecTitle2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="홍대 클라이밍짐"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvRecAddress2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="서울 강남구 논현로76길 27"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"/>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/baseline_edit_location_24"
                                android:contentDescription="위치 아이콘"/>

                            <TextView
                                android:id="@+id/tvRecRegion2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="서울 강남"
                                android:textSize="13sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/baseline_attach_money_24"
                                android:contentDescription="가격 아이콘"/>

                            <TextView
                                android:id="@+id/tvRecPrice2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="132,466 원"
                                android:textSize="13sp"
                                android:layout_marginStart="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/btnFav2"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/baseline_favorite_border_24"
                        android:contentDescription="두 번째 찜 버튼"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
