<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MapActivity">

    <!-- Google Map Fragment -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 검색창 -->
    <RelativeLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_margin="26dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true"
        android:layout_alignParentEnd="true"
        android:background="@drawable/ic_map_searchbar">

        <EditText
            android:id="@+id/search_bar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginEnd="48dp"
            android:background="@android:color/transparent"
            android:hint="장소, 주소로 입력하세요"
            android:padding="8dp"
            android:textColor="@android:color/black"
            android:imeOptions="actionSearch"
            android:inputType="text" />

        <ImageButton
            android:id="@+id/btnMapSearchGlass"
            android:layout_width="40dp"
            android:layout_height="42dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_search_glass"
            android:contentDescription="검색 버튼" />
    </RelativeLayout>

    <!-- 내 위치 버튼 -->
    <FrameLayout
        android:id="@+id/btnMyLocationContainer"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_below="@id/searchContainer"
        android:layout_alignEnd="@id/searchContainer"
        android:layout_marginTop="2dp"
        android:background="@android:color/transparent">

        <ImageView
            android:id="@+id/bgMarkerWon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/ic_marker_won"
            android:contentDescription="내 위치 배경" />

        <ImageView
            android:id="@+id/fgMarker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/ic_marker"
            android:contentDescription="내 위치 아이콘" />
    </FrameLayout>

    <!-- 마커 클릭 시 장소 정보 표시 영역 -->
    <RelativeLayout
        android:id="@+id/placeInfoContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/map_ds"
        android:padding="16dp"
        android:visibility="gone">

        <!-- 상단 헤더 -->
        <LinearLayout
            android:id="@+id/placeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentTop="true">

            <!-- 아이콘 -->
            <ImageView
                android:id="@+id/imageIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_place"
                android:contentDescription="마커 아이콘" />

            <!-- 장소명 + 내리기 버튼 그룹 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="8dp">

                <!-- 장소명 (클릭 시 PlaceDetailActivity로 이동) -->
                <TextView
                    android:id="@+id/placeNameTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="월드수상레저"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:clickable="true"
                    android:onClick="onPlaceNameClicked"
                    tools:ignore="OnClick,SpeakableTextPresentCheck" />

                <!-- 내리기 버튼 -->
                <ImageButton
                    android:id="@+id/btnHidePlaceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:src="@drawable/ic_below"
                    android:contentDescription="내리기 버튼" />
            </LinearLayout>

            <!-- 찜 버튼 -->
            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:src="@drawable/baseline_favorite_border_24"
                android:contentDescription="찜 버튼" />
        </LinearLayout>

        <!-- 주소 -->
        <TextView
            android:id="@+id/placeAddressTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/placeHeader"
            android:layout_marginTop="8dp"
            android:text="경기도 가평군 가평읍 (지번) 가평읍 ***"
            android:textColor="#333333"
            android:textSize="14sp" />

        <!-- 전화번호 -->
        <TextView
            android:id="@+id/placePhoneTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/placeAddressTextView"
            android:layout_marginTop="4dp"
            android:text="010-1234-1234"
            android:textColor="#333333"
            android:textSize="14sp" />
    </RelativeLayout>
</RelativeLayout>
