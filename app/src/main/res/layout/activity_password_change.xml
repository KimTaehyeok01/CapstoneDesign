<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_password_change"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/search_page"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="48dp"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_setting_left_arrow"
        android:contentDescription="뒤로가기"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="비밀번호 변경"
        android:textColor="@android:color/black"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"/>

    <ImageView
        android:id="@+id/lineTop"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:scaleType="fitXY"
        android:src="@drawable/setting_line"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iconCurrentLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="32dp"
        android:src="@drawable/ic_lock"
        app:layout_constraintTop_toBottomOf="@id/lineTop"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvCurrentLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="기존 비밀번호"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/iconCurrentLock"
        app:layout_constraintTop_toTopOf="@id/iconCurrentLock"
        app:layout_constraintBottom_toBottomOf="@id/iconCurrentLock" />

    <EditText
        android:id="@+id/etCurrentPassword"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:hint="기존 비밀번호를 입력해주세요."
        android:inputType="textPassword"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textColorHint="#AAAAAA"
        android:paddingStart="12dp"
        android:paddingBottom="4dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/iconCurrentLock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnToggleCurrentPassword"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/blindfolding"
        app:layout_constraintTop_toBottomOf="@id/iconCurrentLock"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/lineCurrentPassword"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_pw_inputbar"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/etCurrentPassword"
        app:layout_constraintStart_toStartOf="@id/etCurrentPassword"
        app:layout_constraintEnd_toEndOf="@id/etCurrentPassword" />

    <ImageView
        android:id="@+id/iconNewLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_lock"
        app:layout_constraintTop_toBottomOf="@id/lineCurrentPassword"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvNewLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="새 비밀번호"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@id/iconNewLock"
        app:layout_constraintStart_toEndOf="@id/iconNewLock"
        app:layout_constraintTop_toTopOf="@id/iconNewLock" />

    <EditText
        android:id="@+id/etNewPassword"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:hint="새 비밀번호를 입력해주세요."
        android:inputType="textPassword"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textColorHint="#AAAAAA"
        android:paddingStart="12dp"
        android:paddingBottom="4dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/iconNewLock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnToggleNewPassword"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/blindfolding"
        app:layout_constraintTop_toBottomOf="@id/iconNewLock"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/lineNewPassword"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_pw_inputbar"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/etNewPassword"
        app:layout_constraintStart_toStartOf="@id/etNewPassword"
        app:layout_constraintEnd_toEndOf="@id/etNewPassword" />

    <TextView
        android:id="@+id/tvNewPasswordHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="• 6자리 이상 영대 소문자, 숫자, 특수문자 조합해주세요"
        android:textColor="#FF0000"
        android:textSize="12sp"
        app:layout_constraintTop_toBottomOf="@id/lineNewPassword"
        app:layout_constraintStart_toStartOf="@id/etNewPassword" />

    <ImageView
        android:id="@+id/iconConfirmLock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/ic_lock"
        app:layout_constraintTop_toBottomOf="@id/tvNewPasswordHint"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvConfirmLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="비밀번호 확인"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/black"
        android:layout_marginStart="8dp"
        app:layout_constraintBottom_toBottomOf="@id/iconConfirmLock"
        app:layout_constraintStart_toEndOf="@id/iconConfirmLock"
        app:layout_constraintTop_toTopOf="@id/iconConfirmLock" />

    <EditText
        android:id="@+id/etConfirmPassword"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"
        android:hint="비밀번호를 다시 입력해주세요."
        android:inputType="textPassword"
        android:background="@android:color/transparent"
        android:textColor="@android:color/black"
        android:textColorHint="#AAAAAA"
        android:paddingStart="12dp"
        android:paddingBottom="4dp"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/iconConfirmLock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/btnToggleConfirmPassword"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="8dp"
        android:background="@android:color/transparent"
        android:src="@drawable/blindfolding"
        app:layout_constraintTop_toBottomOf="@id/iconConfirmLock"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/lineConfirmPassword"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_pw_inputbar"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/etConfirmPassword"
        app:layout_constraintStart_toStartOf="@id/etConfirmPassword"
        app:layout_constraintEnd_toEndOf="@id/etConfirmPassword" />

    <FrameLayout
        android:id="@+id/btnConfirmContainer"
        android:layout_width="283dp"
        android:layout_height="62dp"
        android:layout_marginBottom="68dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSubmitPassword"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_pw_modify"
            android:scaleType="fitXY"
            android:contentDescription="확인" />

        <TextView
            android:id="@+id/btnSubmitText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="확인"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>