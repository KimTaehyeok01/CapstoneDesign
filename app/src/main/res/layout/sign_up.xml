<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_signup"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".login_signup.SignUpActivity">

    <!-- 전체 배경 -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/sign_up"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 뒤로가기 버튼 -->

    <!-- 상단 타이틀 -->

    <!-- 아이디 입력 -->

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:contentDescription="뒤로가기"
        android:focusable="true"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_left_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textTitleSignup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:text="회원가입"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.491"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/editEmailId"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="40dp"
        android:layout_marginTop="168dp"
        android:layout_marginEnd="8dp"
        android:background="@android:color/transparent"
        android:hint="아이디"
        android:inputType="textEmailAddress"
        android:textColorHint="#CCFFFFFF"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:paddingStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/editEmailDomain" />

    <!-- 도메인 -->
    <EditText
        android:id="@+id/editEmailDomain"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_marginEnd="56dp"
        android:background="@android:color/transparent"
        android:hint="email"
        android:inputType="textEmailAddress"
        android:textColor="@android:color/white"
        android:textColorHint="#CCFFFFFF"
        android:textSize="14sp"
        android:paddingStart="12dp"
        app:layout_constraintTop_toTopOf="@id/editEmailId"
        app:layout_constraintBottom_toBottomOf="@id/editEmailId"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- @ 텍스트 -->
    <TextView
        android:id="@+id/txtAt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="\@"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@id/editEmailId"
        app:layout_constraintBottom_toBottomOf="@id/editEmailId"
        app:layout_constraintStart_toEndOf="@id/editEmailId"
        app:layout_constraintEnd_toStartOf="@id/editEmailDomain" />

    <!--  아이디 아래 선 -->
    <ImageView
        android:id="@+id/line2"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/line2"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/editEmailId"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtAt" />

    <ImageView
        android:id="@+id/line3"
        android:layout_width="100dp"
        android:layout_height="1dp"
        android:layout_marginEnd="56dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/line3"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/editEmailDomain"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 비밀번호 입력 -->
    <EditText
        android:id="@+id/editPassword"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="32dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:hint="비밀번호"
        android:inputType="textPassword"
        android:background="@android:color/transparent"
        android:textColor="@android:color/white"
        android:textColorHint="#CCFFFFFF"
        android:textSize="14sp"
        android:paddingStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/line2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/line4_pw"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:src="@drawable/line4"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/editPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 비밀번호 확인 -->
    <EditText
        android:id="@+id/editConfirmPassword"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:hint="비밀번호 확인"
        android:inputType="textPassword"
        android:background="@android:color/transparent"
        android:textColor="@android:color/white"
        android:textColorHint="#CCFFFFFF"
        android:textSize="14sp"
        android:paddingStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/line4_pw"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/line4_confirm"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:src="@drawable/line4"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/editConfirmPassword"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 이름 입력 -->
    <EditText
        android:id="@+id/editName"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginTop="24dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:hint="이름을 입력해주세요"
        android:background="@android:color/transparent"
        android:textColor="@android:color/white"
        android:textColorHint="#CCFFFFFF"
        android:textSize="14sp"
        android:paddingStart="12dp"
        app:layout_constraintTop_toBottomOf="@id/line4_confirm"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/line4_name"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginStart="40dp"
        android:layout_marginEnd="56dp"
        android:src="@drawable/line4"
        android:scaleType="fitXY"
        app:layout_constraintTop_toBottomOf="@id/editName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 가입 완료 버튼 (FrameLayout로 이미지 + 텍스트 겹치기) -->
    <FrameLayout
        android:id="@+id/signupButtonContainer"
        android:layout_width="351dp"
        android:layout_height="57dp"
        android:layout_marginBottom="64dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnSignUpSubmit"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:src="@drawable/sign_up_button"
            android:scaleType="fitXY"
            android:contentDescription="가입완료"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btnSignUpSubmitText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="가입완료"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center"
            android:textStyle="bold" />
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
