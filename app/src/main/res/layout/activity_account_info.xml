<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_account_info"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 배경 이미지 -->
    <ImageView
        android:id="@+id/imgBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/search_page"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- 본문 ScrollView -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <!-- 상단 영역: 뒤로가기 아이콘 + '계정정보' 타이틀 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <!-- 뒤로가기 아이콘 (왼쪽) -->
                <ImageButton
                    android:id="@+id/btnAccountBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_setting_left_arrow"
                    android:background="@android:color/transparent"
                    android:contentDescription="뒤로가기" />

                <!-- '계정정보' 타이틀 텍스트 (가운데) -->
                <TextView
                    android:id="@+id/tvAccountTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="계정정보"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"
                    android:gravity="center" />
            </LinearLayout>

            <!-- 첫 번째 구분선 -->
            <ImageView
                android:id="@+id/line1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:scaleType="fitXY"
                android:src="@drawable/setting_line" />

            <!-- 이름 변경 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름변경"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/ic_id_pw"
                android:padding="8dp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            <!-- 나이 변경 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나이 변경"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/editAge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/ic_id_pw"
                android:padding="8dp"
                android:textColor="@android:color/black"
                android:layout_marginBottom="16dp" />

            <!-- 로그아웃 버튼 영역 -->
            <LinearLayout
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical|end"
                android:paddingVertical="12dp"
                android:layout_marginBottom="16dp"
                android:clickable="false"
                android:focusable="false">

                <!-- 클릭 가능한 텍스트 -->
                <TextView
                    android:id="@+id/textLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="로그아웃"
                    android:textSize="16sp"
                    android:textColor="@android:color/black"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- 클릭 가능한 화살표 -->
                <ImageView
                    android:id="@+id/arrowLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_information_right_arrow"
                    android:contentDescription="오른쪽 화살표"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- 하단 '수정' 버튼 (아이콘 + 텍스트) -->
            <FrameLayout
                android:id="@+id/btnModifyContainer"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="190dp"
                android:clickable="true"
                android:focusable="true">

                <ImageButton
                    android:id="@+id/btnModify"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_modify"
                    android:scaleType="fitXY"
                    android:background="@android:color/transparent"
                    android:contentDescription="수정 버튼"
                    android:clickable="false"
                    android:focusable="false" />

                <TextView
                    android:id="@+id/tvModify"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="수정"
                    android:textSize="16sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    android:textStyle="bold" />
            </FrameLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
